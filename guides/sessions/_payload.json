57,"meta":158,"style":158},"language-ts shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","import { KeyringSession } from \"tauri-plugin-keyring-store-api\";\n\nconst session = await KeyringSession.load(\"\u002Fapp\u002Fsecrets\", \"\");\nconst client = await session.loadClient(\"desktop\");\nconst store = client.getStore();\n\nawait store.insert(\"settings.json\", new TextEncoder().encode('{\"theme\":\"dark\"}'));\nconst bytes = await store.get(\"settings.json\");\nconst json = bytes && new TextDecoder().decode(bytes);\n\nawait session.unload();\n","ts","",[126,160,161,197,204,250,283,306,311,364,395,427,432],{"__ignoreMap":158},[162,163,166,170,174,178,181,184,187,191,194],"span",{"class":164,"line":165},"line",1,[162,167,169],{"class":168},"s7zQu","import",[162,171,173],{"class":172},"sMK4o"," {",[162,175,177],{"class":176},"sTEyZ"," KeyringSession",[162,179,180],{"class":172}," }",[162,182,183],{"class":168}," from",[162,185,186],{"class":172}," \"",[162,188,190],{"class":189},"sfazB","tauri-plugin-keyring-store-api",[162,192,193],{"class":172},"\"",[162,195,196],{"class":172},";\n",[162,198,200],{"class":164,"line":199},2,[162,201,203],{"emptyLinePlaceholder":202},true,"\n",[162,205,207,211,214,217,220,222,225,229,232,234,237,239,242,245,248],{"class":164,"line":206},3,[162,208,210],{"class":209},"spNyl","const",[162,212,213],{"class":176}," session ",[162,215,216],{"class":172},"=",[162,218,219],{"class":168}," await",[162,221,177],{"class":176},[162,223,224],{"class":172},".",[162,226,228],{"class":227},"s2Zo4","load",[162,230,231],{"class":176},"(",[162,233,193],{"class":172},[162,235,236],{"class":189},"\u002Fapp\u002Fsecrets",[162,238,193],{"class":172},[162,240,241],{"class":172},",",[162,243,244],{"class":172}," \"\"",[162,246,247],{"class":176},")",[162,249,196],{"class":172},[162,251,253,255,258,260,262,265,267,270,272,274,277,279,281],{"class":164,"line":252},4,[162,254,210],{"class":209},[162,256,257],{"class":176}," 