{
  "name": "tauri-plugin-keyring-store-api",
  "version": "0.2.0",
  "author": "s00d",
  "description": "JavaScript API for tauri-plugin-keyring-store — OS keychain / credential manager storage with Stronghold-compatible sessions.",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "types": "./dist-js/index.d.ts",
  "main": "./dist-js/index.cjs",
  "module": "./dist-js/index.js",
  "packageManager": "pnpm@9.15.9",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/s00d/tauri-plugin-keyring-store.git"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist-js/index.d.ts",
        "default": "./dist-js/index.js"
      },
      "require": {
        "types": "./dist-js/index.d.cts",
        "default": "./dist-js/index.cjs"
      }
    }
  },
  "files": [
    "dist-js",
    "README.md",
    "LICENSE-MIT",
    "LICENSE-APACHE"
  ],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json && node -e \"require('fs').copyFileSync('dist-js/index.d.ts','dist-js/index.d.cts')\" && pnpm check:dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "pnpm build",
    "check:dist": "publint --strict && attw --pack . --profile node16 && node scripts/check-dist.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "publint": "^0.3.25",
    "typescript": "^6.0.3",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=20.19"
  }
}
