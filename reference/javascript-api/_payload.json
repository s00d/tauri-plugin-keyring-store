nt.getStore()",[174,247,248],{},"Key-value byte store of this client. No IPC call.",[159,250,251,259],{},[174,252,253],{},[131,254,256],{"href":255},"#keyringstoreviewget",[126,257,258],{},"KeyringStoreView.get()",[174,260,261,262,265,266,269],{},"Reads the record ",[126,263,264],{},"key","; ",[126,267,268],{},"null"," if it does not exist.",[159,271,272,280],{},[174,273,274],{},[131,275,277],{"href":276},"#keyringstoreviewinsert",[126,278,279],{},"KeyringStoreView.insert()",[174,281,282,285],{},[126,283,284],{},"lifetime"," is accepted for Stronghold parity and ignored (OS stores have no expiry).",[159,287,288,296],{},[174,289,290],{},[131,291,293],{"href":292},"#keyringstoreviewremove",[126,294,295],{},"KeyringStoreView.remove()",[174,297,298,299,301,302,304],{},"Deletes the record ",[126,300,264],{},"; resolves to its previous bytes, or ",[126,303,268],{}," if there was none.",[159,306,307,315],{},[174,308,309],{},[131,310,312],{"href":311},"#keyringvaultinsert",[126,313,314],{},"KeyringVault.insert()",[174,316,317,318,321,322,325],{},"Writes ",[126,319,320],{},"secret"," to record ",[126,323,324],{},"recordPath"," of this vault (replaces an existing one). Stored as Base64 text in the OS store.",[159,327,328,336],{},[174,329,330],{},[131,331,333],{"href":332},"#keyringvaultremove",[126,334,335],{},"KeyringVault.remove()",[174,337,338,339,342,343,345,346,349,350,353,354,192],{},"Removes the record at ",[126,340,341],{},"location",", in the vault named by ",[126,344,341],{}," (not ",[126,347,348],{},"this.name","). A counter location ",[126,351,352],{},"n"," addresses the same record as the generic record ",[126,355,356],{},"String(n)",[159,358,359,367],{},[174,360,361],{},[131,362,364],{"href":363},"#keyringvaultgenerateslip10seed",[126,365,366],{},"KeyringVault.generateSLIP10Seed()",[174,368,369,370,373,374,377],{},"Generates a SLIP10 master key into ",[126,371,372],{},"outputLocation"," (",[126,375,376],{},"sizeBytes",": 16..=64, default 32). Resolves to an empty array: key material never leaves Rust.",[159,379,380,388],{},[174,381,382],{},[131,383,385],{"href":384},"#keyringvaultderiveslip10",[126,386,387],{},"KeyringVault.deriveSLIP10()",[174,389,390,391,393],{},"Derives a hardened child key into ",[126,392,372],{},"; resolves to its 32-byte chain code.",[159,395,396,404],{},[174,397,398],{},[131,399,401],{"href":400},"#keyringvaultrecoverbip39",[126,402,403],{},"KeyringVault.recoverBIP39()",[174,405,406,407,409],{},"Restores a BIP39 mnemonic into ",[126,408,372],{},"; resolves to an empty array.",[159,411,412,420],{},[174,413,414],{},[131,415,417],{"href":416},"#keyringvaultgeneratebip39",[126,418,419],{},"KeyringVault.generateBIP39()",[174,421,422,423,425,426,429],{},"Generates a 24-word English mnemonic and stores its SLIP10 master key in ",[126,424,372],{},". Resolves to the mnemonic as UTF-8 bytes (",[126,427,428],{},"new TextDecoder().decode(bytes)",") so the user can back it up.",[159,431,432,440],{},[174,433,434],{},[131,435,437],{"href":436},"#keyringvaultgeted25519publickey",[126,438,439],{},"KeyringVault.getEd25519PublicKey()",[174,441,442,443,446],{},"Reads the Ed25519 key at ",[126,444,445],{},"privateKeyLocation"," (a 32-byte key or a 65-byte SLIP10 extended key) and resolves to its 32-byte public key.",[159,448,449,457],{},[174,450,451],{},[131,452,454],{"href":453},"#keyringvaultsigned25519",[126,455,456],{},"KeyringVault.signEd25519()",[174,458,459,460,463,464,466],{},"Signs the UTF-8 bytes of ",[126,461,462],{},"msg"," with the Ed25519 key at ",[126,465,445],{},"; resolves to the 64-byte signature.",[159,468,469,477],{},[174,470,471],{},[131,472,474],{"href":473},"#keyringsessionload",[126,475,476],{},"KeyringSession.load()",[174,478,479,480,483,484,487,488,490,491,494],{},"Registers session ",[126,481,482],{},"path"," for this process (",[126,485,486],{},"initialize","). ",[126,489,482],{}," is a logical id, not a file; ",[126,492,493],{},"password"," is not verified and is zeroized in Rust.",[159,496,